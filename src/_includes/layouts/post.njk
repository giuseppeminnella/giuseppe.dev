---
layout: layouts/base.njk
---
<article>
  <h1>{{ title_struck | safe if title_struck else title }}</h1>
  <p class="post-meta">{{ date | readableDate }}{% if readingTime %} • {{ readingTime }} min{% endif %}</p>
  {{ content | safe }}
  {% if linkedin_url %}
  <hr>
  <p><a class="btn" href="{{ linkedin_url }}">Discuss on LinkedIn</a></p>
  {% endif %}
</article>
