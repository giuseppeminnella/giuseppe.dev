---
layout: layouts/base.njk
---
{# A talk: the runnable presentation at the top of the article, the reading list in a column on the right for the whole page.
   The deck is self-hosted under /talks/ and embedded from the same origin; front matter: deck (its folder), event, reading (from the post's 11tydata.json). #}
<div class="talk">
  <article>
    <h1>{{ title }}</h1>
    <p class="post-meta">{{ date | readableDate }}{% if event %} • {{ event }}{% endif %}{% if readingTime %} • {{ readingTime }} min{% endif %}</p>
    <figure class="deck">
      <div class="deck-frame">
        <iframe src="{{ deck }}?web" title="The presentation: {{ title }}" loading="lazy" allowfullscreen></iframe>
      </div>
      <figcaption>Click the slide, then use the arrow keys or the space bar; ← goes back. <a href="{{ deck }}?web">Open it on its own page</a> and press F for full screen.</figcaption>
    </figure>
    {{ content | safe }}
    {% if linkedin_url %}
    <hr>
    <p><a class="btn" href="{{ linkedin_url }}">Discuss on LinkedIn</a></p>
    {% endif %}
  </article>
  {% if reading %}
  <aside class="reading" aria-labelledby="reading-list">
    <h2 id="reading-list">Reading list</h2>
    {% for group in reading %}
    <h3>{{ group.title }}</h3>
    <ol>
      {% for item in group.items %}
      <li>
        <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
        <span class="meta">{{ item.meta }}</span>
        <p>{{ item.what }}</p>
        {% if item.note %}<p class="note">{{ item.note }}</p>{% endif %}
        {% if item.also %}<p class="note">{{ item.also.label }} <a href="{{ item.also.url }}" target="_blank" rel="noopener noreferrer">{{ item.also.text }}</a></p>{% endif %}
      </li>
      {% endfor %}
    </ol>
    {% endfor %}
  </aside>
  {% endif %}
</div>
